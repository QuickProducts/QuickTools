<Window x:Class="QuickTools.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="QuickTools — Установка" Width="1000" Height="690" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#10171F" Foreground="#EEF5F8" FontFamily="Segoe UI Variable Text" FontSize="13">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" CornerRadius="18" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#D6E5EA"/><Setter Property="Background" Value="#24323D"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="White"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D3E0E6"/><Setter Property="Margin" Value="0,0,0,15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#16222D"/><Setter Property="Foreground" Value="#CADDE5"/><Setter Property="BorderBrush" Value="#344650"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,11"/><Setter Property="CaretBrush" Value="#96E4D3"/></Style>
 </Window.Resources>
 <Border CornerRadius="18" BorderBrush="#3C525A" BorderThickness="1" Background="#10171F">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border CornerRadius="17,0,0,17" ClipToBounds="True">
   <Grid>
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#092B53" Offset="0"/><GradientStop Color="#091623" Offset=".48"/><GradientStop Color="#142240" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Rectangle x:Name="BrandBackdrop" Opacity=".16" IsHitTestVisible="False"/>
    <Canvas ClipToBounds="True" IsHitTestVisible="False"><Ellipse Width="370" Height="270" Canvas.Left="-90" Canvas.Top="100" Fill="#4CA48F" Opacity=".22"><Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect></Ellipse><Path Data="M-80,540 C190,70 40,670 440,300" Stroke="#ACA0D7" StrokeThickness="70" Opacity=".12"><Path.Effect><BlurEffect Radius="45"/></Path.Effect></Path></Canvas>
    <StackPanel Margin="30,29,24,0" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Image x:Name="BrandLogo" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="QuickTools" FontWeight="SemiBold" FontSize="18" Margin="12,7,0,0"/></StackPanel><TextBlock Text="МЕНЬШЕ КЛИКОВ. БОЛЬШЕ ВОЗМОЖНОСТЕЙ." FontSize="8" Foreground="#92B7B7" Margin="0,16,0,0"/></StackPanel>
    <StackPanel Margin="30,118,24,0" VerticalAlignment="Top"><TextBlock Text="Всё нужное.&#x0a;Рядом с курсором." FontSize="32" FontWeight="SemiBold" LineHeight="39"/><TextBlock Text="Файлы, форматы и быстрые действия —&#x0a;в одном стеклянном круге." FontSize="12" LineHeight="20" Foreground="#AAC3CB" Margin="0,16,0,0"/></StackPanel>
    <Viewbox x:Name="Hero" Width="340" Height="340" VerticalAlignment="Bottom" Margin="0,0,0,61"/>
    <Border VerticalAlignment="Bottom" Margin="30,0,30,28" Padding="13,10" CornerRadius="9" Background="#253F44" BorderBrush="#3D5C61" BorderThickness="1"><TextBlock Text="CTRL + НАВЕДЕНИЕ  /  МАГИЯ НАЧИНАЕТСЯ" FontSize="8" Foreground="#B2DAD3" TextAlignment="Center"/></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="38,24,38,29">
   <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="88"/><RowDefinition/><RowDefinition Height="74"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragTitle"><TextBlock x:Name="StepLabel" Text="01 / УСТАНОВКА" FontSize="9" Foreground="#7F9DA9" VerticalAlignment="Top" Margin="0,8,0,0"/><Button Content="×" FontSize="22" Padding="0" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Click="CloseSetup"/></Grid>
   <StackPanel Grid.Row="1"><TextBlock x:Name="Heading" Text="Привет, QuickTools." FontSize="31" FontWeight="SemiBold"/><TextBlock x:Name="Description" Text="Настроим всё за пару минут." Foreground="#8DA5B4" Margin="0,10,0,0"/></StackPanel>
   <StackPanel x:Name="OptionsPanel" Grid.Row="2">
    <TextBlock Text="ПАПКА ПРИЛОЖЕНИЯ" FontSize="9" Foreground="#7F9DA9" Margin="0,5,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBox x:Name="InstallPath" FontSize="11" AutomationProperties.Name="Папка установки"/><Button Grid.Column="1" Content="…" Margin="7,0,0,0" Padding="0" Click="Browse" ToolTip="Выбрать папку"/></Grid>
    <TextBlock Text="Приложение и .NET уже внутри. Интернет нужен только для конвертеров." Foreground="#6E8B9C" FontSize="10" TextWrapping="Wrap" LineHeight="17" Margin="0,9,0,23"/>
    <TextBlock Text="ДОБАВИМ ВОЗМОЖНОСТИ" FontSize="9" Foreground="#7F9DA9" Margin="0,0,0,15"/>
    <CheckBox x:Name="MediaTools" IsChecked="True" Content="Видео, аудио и изображения"/><CheckBox x:Name="PdfTools" IsChecked="True" Content="PDF → текст, PNG и JPG"/><CheckBox x:Name="OfficeTools" IsChecked="True" Content="Документы · Pandoc + Typst"/>
    <TextBlock Text="Устанавливаем переносимые компоненты без прав администратора. Скачиваем с сайтов проектов и проверяем SHA-256. У каждого компонента своя открытая лицензия." TextWrapping="Wrap" LineHeight="16" Foreground="#6E8B9C" FontSize="10" Margin="0,-5,0,18"/>
    <StackPanel Orientation="Horizontal"><CheckBox x:Name="DesktopShortcut" IsChecked="True" Content="На рабочий стол" Margin="0,0,25,0"/><CheckBox x:Name="StartShortcut" IsChecked="True" Content="В меню «Пуск»" Margin="0"/></StackPanel>
   </StackPanel>
   <StackPanel x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,20,0,0">
    <Grid><TextBlock x:Name="Phase" Text="Подготавливаем файлы…" FontSize="16"/><TextBlock x:Name="Percent" Text="0%" Foreground="#9EE6D5" HorizontalAlignment="Right"/></Grid>
    <ProgressBar x:Name="Progress" Height="5" Background="#273A43" Foreground="#98E2D1" BorderThickness="0" Margin="0,20,0,25"/>
    <TextBlock x:Name="Details" Foreground="#9DB5C1" TextWrapping="Wrap" LineHeight="21"/>
    <Border Background="#182630" BorderBrush="#2E434E" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,30,0,0"><StackPanel><TextBlock Text="Локально. Быстро. По-вашему." FontSize="16"/><TextBlock Text="TXT → BAT и ещё десятки форматов.&#x0a;Исходные файлы остаются на месте." Foreground="#8FAAB8" FontSize="12" LineHeight="23" Margin="0,10,0,0"/></StackPanel></Border>
   </StackPanel>
   <StackPanel x:Name="DonePanel" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"><Border Width="66" Height="66" HorizontalAlignment="Left" Background="#244941" CornerRadius="33"><TextBlock Text="✓" FontSize="32" Foreground="#9EE6D5" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock x:Name="DoneTitle" Text="Всё под рукой." FontSize="24" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBlock x:Name="DoneDescription" Text="Удерживайте Ctrl над файлом в Проводнике.&#x0a;Ctrl + Space — действия для выделенной группы." TextWrapping="Wrap" Foreground="#9DB5C1" LineHeight="23" Margin="0,13,0,0"/><TextBlock x:Name="Warnings" TextWrapping="Wrap" Foreground="#DEBB93" FontSize="11" LineHeight="18" Margin="0,20,0,0"/></StackPanel>
   <Grid Grid.Row="3" VerticalAlignment="Bottom"><StackPanel VerticalAlignment="Center"><TextBlock Text="QUICKTOOLS 0.4.2" FontSize="9" Foreground="#688594"/><TextBlock x:Name="Footer" Text="Без магазинов и менеджеров пакетов" FontSize="9" Foreground="#688594" Margin="0,5,0,0"/></StackPanel><Button x:Name="PrimaryButton" Content="Установить QuickTools  →" Background="#98E2D1" Foreground="#15342F" FontWeight="SemiBold" HorizontalAlignment="Right" Click="PrimaryClick"/></Grid>
  </Grid>
 </Grid>
 </Border>
</Window>



